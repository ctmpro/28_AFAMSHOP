# =====================================================================
# AFAMSHOP — modèle de fichier .env
# Copier ce fichier en 01_PROD/.env puis renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être versionné ni accessible depuis le web.
# =====================================================================

# --- Application
APP_ENV=production            # production | local
APP_DEBUG=false               # true uniquement en développement
APP_URL=https://afamshop.sn   # URL publique sans "/" final (vide = détection automatique)
APP_LANG=fr
APP_TIMEZONE=Africa/Dakar
FORCE_HTTPS=true
UPLOAD_MAX_SIZE=8388608       # 8 Mo

# --- Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=afamshop
DB_USER=
DB_PASS=

# --- Emails (PHPMailer dans utilitaires/PHPMailer)
MAIL_DRIVER=smtp              # smtp | log (log = emails écrits dans uploads/private/mails, pour les tests)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls               # tls | ssl | none
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@afamshop.sn
MAIL_FROM_NAME=AFAMSHOP

# --- Stripe (carte bancaire)
STRIPE_SECRET_KEY=            # sk_live_... / sk_test_...
STRIPE_PUBLISHABLE_KEY=       # pk_live_... / pk_test_...
STRIPE_WEBHOOK_SECRET=        # whsec_...

# --- PayDunya (Wave, Orange Money...)
PAYDUNYA_MODE=test            # test | live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=

# --- Google reCAPTCHA (librairie dans utilitaires/ReCaptcha)
RECAPTCHA_VERSION=v2          # v2 | v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
